+	int m_viewType;
+	struct internal
+	{
+		float m_pan;
+		float m_tilt;
+		float m_roll;
+		float m_zoom;
+	} m_data[4];
+
+	std::unique_ptr<IMV_CameraInterface> m_camera;
+	InputOutputBuffers m_buffers;
+	std::string m_acsInfo;
+	bool m_isCameraSetup;
+	bool m_isLensCalibrated;
+
+	std::mutex m_render;
+
+};
